{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "app.py": {
      "excludeFiles": "{MSCardio/**,data/**,tests/**,checkpoints/**,notebooks/**,scratch/**}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/app.py" },
    { "source": "/auth", "destination": "/app.py" },
    { "source": "/heartprint", "destination": "/app.py" },
    { "source": "/(.*)", "destination": "/app.py" }
  ]
}
